/* =============================================
   SafeGuard – Accident Detection Dashboard
   style.css | Clean Healthcare UI
   ============================================= */

/* ---- Reset & Base ---- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Inter', sans-serif;
  background: linear-gradient(135deg, #e8f4fd 0%, #f0f7ff 50%, #e6f0fb 100%);
  min-height: 100vh;
  color: #2d3748;
}

/* ---- Header ---- */
.header {
  background: #ffffff;
  box-shadow: 0 2px 12px rgba(66, 133, 244, 0.1);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 16px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo-icon { font-size: 1.6rem; }

.logo-text {
  font-size: 1.4rem;
  font-weight: 700;
  color: #1a73e8;
  letter-spacing: -0.5px;
}

.header-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.9rem;
  font-weight: 500;
  color: #4a5568;
}

.btn-logout {
  background: #ffffff;
  color: #1a73e8;
  border: 1px solid #d2e3fc;
  padding: 10px 16px;
  border-radius: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-logout:hover {
  background: #f1f5ff;
}

/* Animated status dot */
.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #ccc;
}
.dot.active {
  background: #34a853;
  animation: pulse-green 2s infinite;
}
.dot.danger {
  background: #ea4335;
  animation: pulse-red 1s infinite;
}

@keyframes pulse-green {
  0%, 100% { box-shadow: 0 0 0 0 rgba(52, 168, 83, 0.4); }
  50% { box-shadow: 0 0 0 6px rgba(52, 168, 83, 0); }
}

@keyframes pulse-red {
  0%, 100% { box-shadow: 0 0 0 0 rgba(234, 67, 53, 0.5); }
  50% { box-shadow: 0 0 0 8px rgba(234, 67, 53, 0); }
}

/* ---- Alert Banner ---- */
.alert-banner {
  display: none;
  background: #fff3cd;
  border-bottom: 3px solid #f6a623;
  padding: 14px 24px;
}

.alert-banner.show {
  display: block;
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from { transform: translateY(-100%); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}

.alert-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.alert-icon { font-size: 1.5rem; flex-shrink: 0; }

.alert-text { flex: 1; }
.alert-text strong { color: #856404; font-size: 1rem; }
.alert-text p { font-size: 0.88rem; color: #856404; margin-top: 3px; }

.alert-dismiss {
  background: #f6a623;
  color: #fff;
  border: none;
  padding: 7px 16px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.85rem;
  flex-shrink: 0;
  transition: background 0.2s;
}
.alert-dismiss:hover { background: #e09000; }

/* ---- Main Layout ---- */
.main {
  max-width: 1200px;
  margin: 0 auto;
  padding: 28px 20px 40px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* ---- Grid ---- */
.grid {
  display: grid;
  gap: 20px;
}
.grid-2 { grid-template-columns: 1fr 1fr; }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

/* ---- Cards ---- */
.card {
  background: #ffffff;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 2px 16px rgba(66, 133, 244, 0.07);
  transition: box-shadow 0.3s ease;
}

.card:hover {
  box-shadow: 0 4px 24px rgba(66, 133, 244, 0.12);
}

.full-card { width: 100%; }

.card-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

.card-icon { font-size: 1.3rem; }

.card-title {
  font-size: 1.05rem;
  font-weight: 600;
  color: #1a202c;
  flex: 1;
}

/* ---- Badge ---- */
.badge {
  font-size: 0.78rem;
  font-weight: 600;
  padding: 4px 12px;
  border-radius: 20px;
  background: #e8f5e9;
  color: #2e7d32;
  transition: all 0.3s;
}
.badge.warn {
  background: #fff3e0;
  color: #e65100;
}
.badge.alert {
  background: #fdecea;
  color: #c62828;
}

.subtle-note {
  font-size: 0.78rem;
  color: #9ca3af;
  font-style: italic;
  margin-left: auto;
}

/* ---- Status Card ---- */
.status-card {
  border-left: 4px solid #1a73e8;
  transition: border-color 0.4s ease, background 0.4s ease;
}

.status-card.danger {
  border-left-color: #ea4335;
  background: #fff8f8;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  background: #f0f7ff;
  border-radius: 10px;
  margin-bottom: 16px;
  font-weight: 600;
  font-size: 0.95rem;
  color: #1a73e8;
  transition: all 0.4s;
}

.status-badge.alert-mode {
  background: #fdecea;
  color: #c62828;
}

.status-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #34a853;
  animation: pulse-green 2s infinite;
  flex-shrink: 0;
}

.status-dot.danger {
  background: #ea4335;
  animation: pulse-red 1s infinite;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 9px 0;
  border-bottom: 1px solid #f1f5f9;
  font-size: 0.88rem;
}

.info-row:last-child { border-bottom: none; }

.info-label { color: #6b7280; font-weight: 500; }
.info-value { color: #111827; font-weight: 600; }

/* ---- Phone Model ---- */
.phone-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.phone-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  flex: 1;
  padding: 20px 0;
}

.phone-model {
  width: 80px;
  height: 145px;
  background: linear-gradient(145deg, #f0f4ff, #dce8ff);
  border-radius: 18px;
  border: 3px solid #c5d8f8;
  box-shadow: 0 8px 24px rgba(66, 133, 244, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: idle-float 3s ease-in-out infinite;
  transition: animation 0.3s;
}

@keyframes idle-float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50%       { transform: translateY(-6px) rotate(1.5deg); }
}

@keyframes shake-impact {
  0%   { transform: translate(0, 0) rotate(0deg); }
  10%  { transform: translate(-8px, -5px) rotate(-6deg); }
  20%  { transform: translate(8px, 5px)  rotate(5deg); }
  30%  { transform: translate(-6px, 3px) rotate(-4deg); }
  40%  { transform: translate(6px, -3px) rotate(4deg); }
  50%  { transform: translate(-4px, 2px) rotate(-2deg); }
  60%  { transform: translate(4px, -1px) rotate(2deg); }
  70%  { transform: translate(-2px, 1px) rotate(-1deg); }
  80%  { transform: translate(2px, 0px)  rotate(1deg); }
  90%  { transform: translate(-1px, 0px) rotate(-0.5deg); }
  100% { transform: translate(0, 0)      rotate(0deg); }
}

.phone-model.shaking {
  animation: shake-impact 0.8s ease-out;
  border-color: #f6a623;
  background: linear-gradient(145deg, #fff8e8, #ffefc0);
}

.phone-model.stopped {
  animation: none;
  transform: rotate(25deg) translateY(10px);
  border-color: #ea4335;
  background: linear-gradient(145deg, #fff0f0, #ffd6d6);
}

.phone-screen {
  width: 60px;
  height: 115px;
  background: #1a73e8;
  border-radius: 10px;
  padding: 12px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.screen-dot {
  width: 10px;
  height: 10px;
  background: rgba(255,255,255,0.5);
  border-radius: 50%;
}

.screen-line {
  height: 4px;
  background: rgba(255,255,255,0.7);
  border-radius: 4px;
  width: 100%;
}

.screen-line.short { width: 60%; }

.phone-label {
  font-size: 0.83rem;
  color: #6b7280;
  font-weight: 500;
  margin-top: 8px;
}

/* ---- Metric Boxes ---- */
.metric-box {
  background: #f8faff;
  border-radius: 12px;
  padding: 16px;
  text-align: center;
  border: 1px solid #e8f0fe;
  transition: background 0.3s;
}

.metric-box.highlight {
  background: #fff8f0;
  border-color: #fde8cc;
}

.metric-label {
  display: block;
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #9ca3af;
  margin-bottom: 8px;
}

.metric-value {
  display: block;
  font-size: 1.9rem;
  font-weight: 700;
  color: #1a202c;
  line-height: 1;
  margin-bottom: 2px;
}

.metric-unit {
  display: block;
  font-size: 0.75rem;
  color: #9ca3af;
  margin-bottom: 12px;
}

.bar-track {
  background: #e5e7eb;
  border-radius: 6px;
  height: 6px;
  overflow: hidden;
}

.bar-fill {
  height: 6px;
  background: #1a73e8;
  border-radius: 6px;
  width: 5%;
  transition: width 0.5s ease;
}

.bar-fill.danger {
  background: linear-gradient(90deg, #f6a623, #ea4335);
}

/* ---- Health Cards ---- */
.health-card {
  background: #f9fafb;
  border-radius: 14px;
  padding: 20px 16px;
  text-align: center;
  border: 1px solid #e5e7eb;
  transition: transform 0.2s;
}

.health-card:hover { transform: translateY(-2px); }

.health-icon { font-size: 2rem; margin-bottom: 8px; }

.health-label {
  font-size: 0.82rem;
  font-weight: 600;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  margin-bottom: 10px;
}

.health-value {
  font-size: 2.2rem;
  font-weight: 700;
  color: #1a202c;
  line-height: 1;
}

.health-unit {
  font-size: 0.78rem;
  color: #9ca3af;
  margin-bottom: 14px;
  margin-top: 2px;
}

.health-bar-track {
  background: #e5e7eb;
  border-radius: 6px;
  height: 7px;
  overflow: hidden;
  margin-bottom: 8px;
}

.health-bar {
  height: 7px;
  border-radius: 6px;
  transition: width 0.8s ease;
}
.health-bar.green  { background: linear-gradient(90deg, #34a853, #4caf50); }
.health-bar.blue   { background: linear-gradient(90deg, #1a73e8, #42a5f5); }
.health-bar.orange { background: linear-gradient(90deg, #f6a623, #ffc107); }

.health-range {
  font-size: 0.75rem;
  color: #9ca3af;
}

/* ---- Hospital Cards ---- */
.hospital-card {
  background: #f9fafb;
  border-radius: 14px;
  padding: 18px;
  border: 1px solid #e5e7eb;
}

.hospital-name {
  font-size: 1rem;
  font-weight: 700;
  color: #1a202c;
  margin-bottom: 10px;
}

.hospital-detail {
  font-size: 0.84rem;
  color: #4b5563;
  margin-bottom: 5px;
  line-height: 1.5;
}

.hospital-tag {
  display: inline-block;
  margin-top: 10px;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 4px 12px;
  border-radius: 20px;
  background: #e8f5e9;
  color: #2e7d32;
}
.hospital-tag.emergency {
  background: #fdecea;
  color: #c62828;
}

/* ---- Emergency Contact Section ---- */
.emergency-section {
  background: transparent;
  padding: 0;
}

.contact-panel,
.location-alert-panel {
  background: #ffffff;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 2px 16px rgba(66, 133, 244, 0.08);
}

.contact-form {
  display: grid;
  gap: 14px;
  margin-bottom: 20px;
}

.input-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #475569;
}

.contact-form input {
  border: 1px solid #dbeafe;
  border-radius: 12px;
  padding: 12px 14px;
  font-size: 0.95rem;
  color: #1f2937;
  background: #f8fbff;
}

.btn-add-contact {
  background: linear-gradient(135deg, #1a73e8, #1557b0);
  color: white;
  border: none;
  padding: 14px 22px;
  border-radius: 12px;
  font-size: 0.95rem;
  font-weight: 700;
  cursor: pointer;
}

.btn-add-contact:hover {
  transform: translateY(-1px);
}

.contact-note {
  font-size: 0.84rem;
  color: #475569;
  min-height: 20px;
}

.section-title {
  font-size: 0.95rem;
  font-weight: 700;
  color: #111827;
  margin-bottom: 14px;
}

.contact-list {
  display: grid;
  gap: 12px;
}

.contact-placeholder,
.alert-placeholder {
  color: #6b7280;
  font-size: 0.95rem;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border-radius: 14px;
  background: #f8faff;
  border: 1px solid #e2e8f0;
}

.contact-meta {
  display: grid;
  gap: 4px;
}

.contact-relationship {
  color: #6b7280;
  font-size: 0.83rem;
}

.contact-name {
  font-weight: 700;
  color: #111827;
}

.contact-phone {
  color: #475569;
  font-size: 0.92rem;
}

.contact-remove {
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  color: #1f2937;
  padding: 10px 14px;
  border-radius: 12px;
  font-size: 0.85rem;
  cursor: pointer;
}

.contact-remove:hover {
  background: #e2e8f0;
}

.location-card,
.alert-status {
  background: #f8fbff;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 20px;
}

.location-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.95rem;
  color: #334155;
  padding: 12px 0;
  border-bottom: 1px solid #e2e8f0;
}

.location-row:last-child { border-bottom: none; }

.maps-link {
  display: inline-block;
  margin-top: 18px;
  color: #1a73e8;
  font-weight: 600;
  text-decoration: none;
}

.maps-link:hover {
  text-decoration: underline;
}

.alert-status-list {
  display: grid;
  gap: 16px;
}

.alert-card {
  background: white;
  border-radius: 16px;
  padding: 18px 20px;
  box-shadow: 0 2px 12px rgba(15, 23, 42, 0.06);
  border: 1px solid #e2e8f0;
}

.alert-card strong {
  color: #0f172a;
}

.alert-card p {
  margin-top: 8px;
  color: #475569;
  line-height: 1.5;
}

.alert-status-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  font-size: 0.88rem;
  color: #1a73e8;
}

.alert-placeholder {
  color: #6b7280;
  font-size: 0.95rem;
}

/* ---- Simulate Section ---- */
.simulate-section { text-align: center; }

.simulate-desc {
  font-size: 0.92rem;
  color: #6b7280;
  margin-bottom: 24px;
  max-width: 560px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.6;
}

.simulate-actions {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}

.btn-simulate {
  background: linear-gradient(135deg, #ea4335, #d93025);
  color: white;
  border: none;
  padding: 14px 32px;
  border-radius: 12px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(234, 67, 53, 0.3);
  transition: all 0.2s;
}

.btn-simulate:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(234, 67, 53, 0.4);
}

.btn-simulate:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.btn-reset {
  background: #f1f5f9;
  color: #374151;
  border: 2px solid #e2e8f0;
  padding: 14px 28px;
  border-radius: 12px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-reset:hover {
  background: #e2e8f0;
  transform: translateY(-1px);
}

/* ---- Footer ---- */
.footer {
  text-align: center;
  padding: 20px;
  font-size: 0.8rem;
  color: #9ca3af;
  border-top: 1px solid #e5e7eb;
  background: #fff;
}

/* ---- Modal ---- */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.modal-overlay.show {
  display: flex;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.countdown-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.7);
  z-index: 1000;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.countdown-overlay.show {
  display: flex;
}

.countdown-popup {
  background: #ffffff;
  border-radius: 20px;
  padding: 32px 28px;
  text-align: center;
  max-width: 420px;
  width: 100%;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
}

.countdown-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #c62828;
  margin-bottom: 12px;
}

.countdown-text {
  font-size: 0.95rem;
  color: #475569;
  margin-bottom: 18px;
}

.countdown-timer {
  font-size: 4rem;
  font-weight: 800;
  color: #1a202c;
  margin-bottom: 22px;
}

.btn-cancel-safe {
  background: #1a73e8;
  color: white;
  border: none;
  padding: 14px 26px;
  border-radius: 14px;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.btn-cancel-safe:hover {
  transform: translateY(-1px);
}

.modal {
  background: #ffffff;
  border-radius: 20px;
  padding: 36px 32px;
  max-width: 460px;
  width: 100%;
  text-align: center;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
  animation: modalPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalPop {
  from { transform: scale(0.85); opacity: 0; }
  to   { transform: scale(1);    opacity: 1; }
}

.modal-icon {
  font-size: 3.5rem;
  margin-bottom: 12px;
}

.modal-title {
  font-size: 1.6rem;
  font-weight: 700;
  color: #c62828;
  margin-bottom: 12px;
}

.modal-body {
  font-size: 0.95rem;
  color: #4b5563;
  line-height: 1.6;
  margin-bottom: 20px;
}

.modal-info {
  background: #f9fafb;
  border-radius: 12px;
  padding: 16px 20px;
  margin-bottom: 16px;
  text-align: left;
}

.modal-row {
  font-size: 0.88rem;
  color: #374151;
  padding: 6px 0;
  border-bottom: 1px solid #e5e7eb;
}
.modal-row:last-child { border-bottom: none; }

.modal-note {
  font-size: 0.85rem;
  color: #2e7d32;
  background: #e8f5e9;
  padding: 10px 16px;
  border-radius: 8px;
  margin-bottom: 22px;
}

.btn-modal-close {
  background: linear-gradient(135deg, #1a73e8, #1557b0);
  color: white;
  border: none;
  padding: 14px 28px;
  border-radius: 12px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  width: 100%;
  transition: all 0.2s;
}

.btn-modal-close:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(26, 115, 232, 0.3);
}

.btn-modal-action {
  background: linear-gradient(135deg, #0f9d58, #0b7c42);
  color: white;
  border: none;
  padding: 14px 28px;
  border-radius: 12px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  width: 100%;
  margin-bottom: 12px;
  transition: all 0.2s;
}

.btn-modal-action:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(15, 157, 88, 0.3);
}

/* ---- Authentication Pages ---- */
.auth-container {
  max-width: 420px;
  margin: 60px auto 80px;
  padding: 0 20px;
}

.auth-card {
  background: #ffffff;
  border-radius: 24px;
  padding: 32px 28px;
  box-shadow: 0 12px 36px rgba(66, 133, 244, 0.12);
}

.auth-card h2 {
  font-size: 1.6rem;
  color: #1a202c;
  margin-bottom: 12px;
}

.auth-card p {
  color: #4b5563;
  margin-bottom: 24px;
  line-height: 1.6;
}

.auth-form {
  display: grid;
  gap: 16px;
}

.auth-form label {
  font-size: 0.9rem;
  color: #475569;
  font-weight: 600;
}

.auth-form input {
  width: 100%;
  border: 1px solid #dbeafe;
  border-radius: 14px;
  padding: 14px 16px;
  background: #f8fbff;
  font-size: 0.95rem;
  color: #1f2937;
}

.auth-button {
  background: linear-gradient(135deg, #1a73e8, #1557b0);
  color: white;
  border: none;
  padding: 14px 18px;
  border-radius: 14px;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
}

.auth-footer {
  margin-top: 18px;
  text-align: center;
}

.auth-link {
  color: #1a73e8;
  font-weight: 700;
  text-decoration: none;
}

.auth-message {
  font-size: 0.9rem;
  min-height: 24px;
  color: #155e75;
}

/* ---- Responsive ---- */
@media (max-width: 900px) {
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .grid-3 { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
  .header-inner { padding: 14px 16px; }
  .main { padding: 16px 14px 32px; }
  .card { padding: 18px 16px; }
  .logo-text { font-size: 1.2rem; }
  .modal { padding: 24px 20px; }
}